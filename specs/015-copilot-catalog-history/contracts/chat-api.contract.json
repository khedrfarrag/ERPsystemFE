{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiChatResponseWithActions",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string",
      "description": "Conversational markdown response generated by the AI model in Arabic"
    },
    "model": {
      "type": "string",
      "description": "Name of the AI model that served the response"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["DOWNLOAD_CATALOG", "DISAMBIGUATE_PRODUCT", "CREATE_PRODUCT"]
          },
          "title": { "type": "string" },
          "filename": { "type": "string" },
          "query": { "type": "string" },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "currentStock", "sellingPrice"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "currentStock": { "type": "number" },
                "sellingPrice": { "type": "number" },
                "categoryName": { "type": "string" }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "category", "unit", "sellingPrice"],
              "properties": {
                "name": { "type": "string" },
                "barcode": { "type": ["string", "null"] },
                "category": { "type": "string" },
                "unit": { "type": "string" },
                "sellingPrice": { "type": "number", "minimum": 0 },
                "purchaseCost": { "type": ["number", "null"], "minimum": 0 },
                "minStockLevel": { "type": ["number", "null"], "minimum": 0 },
                "description": { "type": ["string", "null"] },
                "wholesalePrice": { "type": ["number", "null"] },
                "isWholesaleAvailable": { "type": "boolean" }
              }
            }
          },
          "product": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "barcode": { "type": ["string", "null"] },
              "categoryName": { "type": "string" },
              "unitName": { "type": "string" },
              "sellingPrice": { "type": "number" },
              "purchaseCost": { "type": "number" },
              "minStockLevel": { "type": "number" },
              "initialStock": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "required": ["reply", "model"]
}
